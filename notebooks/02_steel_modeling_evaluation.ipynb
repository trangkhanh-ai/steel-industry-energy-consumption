    "# STEP 11: EXPORT FORMAL ALERT POLICY CARD (POLICY.JSON)\n",
    "import hashlib\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"STEP 11: EXPORTING FORMAL ALERT POLICY (POLICY.JSON)\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "def compute_file_sha256(filepath: Path) -> str:\n",
    "    \"\"\"Tự động tính mã băm SHA-256 để chống can thiệp file mô hình.\"\"\"\n",
    "    if not filepath.exists():\n",
    "        return \"FILE_NOT_FOUND\"\n",
    "    hasher = hashlib.sha256()\n",
    "    with open(filepath, \"rb\") as f:\n",
    "        while chunk := f.read(65536):\n",
    "            hasher.update(chunk)\n",
    "    return hasher.hexdigest()\n",
    "\n",
    "model_file = ARTIFACTS_DIR / \"lightgbm_model.txt\"\n",
    "model_hash = compute_file_sha256(model_file)\n",
    "\n",
    "# Khởi tạo nội dung policy chuẩn hóa\n",
    "policy_data = {\n",
    "    \"policy_metadata\": {\n",
    "        \"policy_version\": \"1.0.0\",\n",
    "        \"created_at\": datetime.now(timezone.utc).isoformat(),\n",
    "        \"author\": \"Khanh (QA & Evaluation Lead)\",\n",
    "        \"target_model\": \"LightGBM_Regressor_v1\",\n",
    "        \"model_artifact_path\": \"artifacts/lightgbm_model.txt\",\n",
    "        \"model_sha256\": model_hash,\n",
    "        \"feature_schema\": ALL_FEATURES\n",
    "    },\n",
    "    \"calibration_parameters\": {\n",
    "        \"threshold_T_source\": \"train_target_p95_kWh\",\n",
    "        \"threshold_T_value_kWh\": float(ALERT_THRESHOLD),\n",
    "        \"calibration_split\": \"October_2018\",\n",
    "        \"buffer_b_formula\": \"max(0, Q90(y_true - y_pred))\",\n",
    "        \"buffer_b_value_kWh\": round(float(q_90), 2),\n",
    "        \"model_buffer_compatibility_warning\": \"Giá trị buffer b=42.35 kWh CHỈ ÁP DỤNG cho LightGBM v1. Tuyệt đối không dùng cho HistGradientBoosting của Duy/Huy.\"\n",
    "    },\n",
    "    \"decision_logic\": {\n",
    "        \"trigger_condition\": \"(y_pred + buffer_b) > threshold_T\",\n",
    "        \"severity_levels\": {\n",
    "            \"NORMAL\": f\"y_pred + buffer_b <= {ALERT_THRESHOLD:.3f}\",\n",
    "            \"PEAK_RISK_WARNING\": f\"y_pred + buffer_b > {ALERT_THRESHOLD:.3f}\"\n",
    "        },\n",
    "        \"episode_grouping\": {\n",
    "            \"max_gap_minutes\": 15,\n",
    "            \"min_consecutive_steps\": 1\n",
    "        },\n",
    "        \"fallback_policy\": {\n",
    "            \"on_missing_features\": \"FALLBACK_TO_LAST_HOUR_PERSISTENCE\",\n",
    "            \"on_sensor_out_of_bound\": \"CLAMP_AND_ALERT_OPERATOR\"\n",
    "        }\n",
    "    }\n",
    "}\n",
    "\n",
    "policy_path = ARTIFACTS_DIR / \"policy.json\"\n",
    "with open(policy_path, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(policy_data, f, indent=2, ensure_ascii=False)\n",
    "\n",
    "print(f\"Model SHA-256: {model_hash}\")\n",
    "print(f\"Policy card exported successfully to: {policy_path.resolve()}\")"
   ]
