    "# STEP 7: HISTORICAL DIURNAL MEAN BASELINE (168 SLOTS - FIT CHI TREN TRAIN)\n",
    "print(\"Step 7: Computing Diurnal Mean Baseline\")\n",
    "\n",
    "def fit_diurnal_baseline(train_df):\n",
    "    \"\"\"Tinh muc tieu thu trung binh theo tung slot (Gio x Thu trong tuan) chi tu Train.\"\"\"\n",
    "    df = train_df.copy()\n",
    "    ts = pd.to_datetime(df[\"forecast_start\"])\n",
    "    df[\"hour\"] = ts.dt.hour\n",
    "    df[\"dayofweek\"] = ts.dt.dayofweek\n",
    "    # Bang tra cuu 168 slots (24 gio x 7 ngay)\n",
    "    lookup = df.groupby([\"dayofweek\", \"hour\"])[TARGET].mean().to_dict()\n",
    "    global_mean = df[TARGET].mean()\n",
    "    return lookup, global_mean\n",
    "\n",
    "def predict_diurnal_baseline(target_df, lookup, global_mean):\n",
    "    ts = pd.to_datetime(target_df[\"forecast_start\"])\n",
    "    hours = ts.dt.hour\n",
    "    dows = ts.dt.dayofweek\n",
    "    preds = [lookup.get((d, h), global_mean) for d, h in zip(dows, hours)]\n",
    "    return np.array(preds)\n",
    "\n",
    "# Fit ONLY on train to avoid leakage\n",
    "diurnal_lookup, global_train_mean = fit_diurnal_baseline(train_df)\n",
    "print(f\"Diurnal combinations learned: {len(diurnal_lookup)} (out of 168 max weekly slots)\")\n",
    "\n",
    "val_diurnal_pred = predict_diurnal_baseline(val_df, diurnal_lookup, global_train_mean)\n",
    "val_diurnal_mae = mean_absolute_error(val_df[TARGET], val_diurnal_pred)\n",
    "print(f\"Diurnal Mean MAE (Validation): {val_diurnal_mae:.2f} kWh\")\n",
    "\n",
    "# STEP 8: QUY TAC CHON MO HINH (STRICT VALIDATION SELECTION)\n",
    "# Tuyet doi khong dung Test set de chon model thang cuoc\n",
    "y_val = val_df[TARGET].values\n",
    "val_pred_persistence = val_df['usage_sum_last_1h'].values\n",
    "val_pred_diurnal = val_diurnal_pred\n",
    "val_pred_ridge = ridge.predict(X_val)\n",
    "val_pred_lgbm = lgb_pred_val\n",
    "\n",
    "val_results = {\n",
    "    \"Persistence\": mean_absolute_error(y_val, val_pred_persistence),\n",
    "    \"Diurnal_Mean\": mean_absolute_error(y_val, val_pred_diurnal),\n",
    "    \"Ridge\": mean_absolute_error(y_val, val_pred_ridge),\n",
    "    \"LightGBM\": mean_absolute_error(y_val, val_pred_lgbm)\n",
    "}\n",
    "\n",
    "# Chon mo hinh tot nhat can cu duy nhat tren Validation MAE\n",
    "selected_model_name = min(val_results, key=val_results.get)\n",
    "print(f\"[MODEL SELECTION] Mo hinh duoc chon dua tren Validation MAE: {selected_model_name} (MAE: {val_results[selected_model_name]:.4f} kWh)\")\n",
    "print(\"Luu y: Tap Test chi dung mot lan duy nhat de danh gia hau nghiem, khong dung de chon mo hinh.\")\n"
